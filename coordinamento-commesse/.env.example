# Copia questo file in .env (nella cartella principale del progetto, allo
# stesso livello di questa guida) e completa i valori. Il file .env non
# viene mai versionato (è escluso da .gitignore).

# Chiave per la generazione ragionata delle Lezioni Apprese (pulsante
# "+ Genera da registri"): https://console.anthropic.com/settings/keys
# Senza questa chiave il pulsante resta disponibile ma mostra un messaggio
# che spiega come attivarlo, invece di generare lezioni finte.
ANTHROPIC_API_KEY=

# Facoltativo: modello da usare per la generazione (default claude-haiku-5-5,
# il più rapido ed economico adatto a questo compito).
# ANTHROPIC_MODEL=claude-haiku-5-5

# Server SMTP per le notifiche email di scadenza (cut-off Approvazioni
# Drawings, criticità urgenti) — vedi GUIDA_AGGIORNAMENTI.md. Senza questi
# valori lo script di notifica non invia nulla e lo segnala nel log,
# invece di fallire in modo silenzioso.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Mittente mostrato nelle email; se vuoto usa SMTP_USER.
SMTP_FROM=
# true solo se il provider richiede SSL implicito sulla porta 465.
SMTP_SECURE=false

# Facoltativo: ora (0-23, fuso del Mac) in cui inviare il riepilogo
# giornaliero delle scadenze, oltre agli avvisi immediati sempre attivi.
# NOTIFICHE_DIGEST_ORA=7

# Note al Diario di Cantiere via WhatsApp — vedi GUIDA_WHATSAPP.md per la
# procedura completa, passo per passo, su Meta for Developers.

# Stringa a scelta (inventala tu, es. una password qualsiasi): va
# inserita identica anche nel pannello Meta quando si configura il
# webhook, per dimostrare che la richiesta di verifica viene davvero da lì.
WHATSAPP_VERIFY_TOKEN=

# "App Secret" dell'app Meta for Developers (non l'Access Token): usato
# per verificare che ogni messaggio in arrivo venga davvero da Meta,
# invece di accettare richieste da chiunque conosca l'indirizzo del
# webhook. Senza questo valore le richieste vengono accettate senza
# verifica, con un avviso nei log — da configurare prima di andare oltre
# un primo collaudo.
WHATSAPP_APP_SECRET=

# Token di accesso e ID del numero di telefono (dal pannello Meta for
# Developers → WhatsApp → Configurazione API): servono solo per mandare
# la conferma "✓ Aggiunto al Diario..." dopo ogni nota — senza questi due
# valori la nota viene comunque registrata, solo senza risposta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Numeri di telefono autorizzati a scrivere nel Diario via WhatsApp,
# separati da virgola, in formato internazionale senza "+" (es. il tuo
# numero italiano: 393401234567). Un messaggio da un numero non in
# questo elenco viene ignorato.
WHATSAPP_NUMERI_AUTORIZZATI=

# Facoltativo: id della commessa (numero, vedi colonna "id" — non il
# codice) usata quando il messaggio non specifica un codice commessa
# all'inizio (es. "2514RW: ..."). Senza questo valore si usa la prima
# commessa attiva.
# WHATSAPP_COMMESSA_DEFAULT_ID=1
